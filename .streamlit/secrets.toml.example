# Streamlit Community Cloud secrets — EXAMPLE FILE.
#
# Copy to `.streamlit/secrets.toml` (local) or paste into
# Streamlit Community Cloud -> App settings -> Secrets.
#
# NEVER commit the real secrets.toml to GitHub (it is .gitignore'd).
# NEVER put the Supabase service-role key here: the app only needs the
# PUBLIC anon key (Row Level Security still protects every row).

SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_ANON_KEY = "YOUR-PUBLIC-ANON-KEY"

# Optional: Cloudflare Workers AI (Speech-to-Text). When absent the app runs
# in clearly-labelled Preview Mode with simulated transcriptions.
CLOUDFLARE_ACCOUNT_ID = ""
CLOUDFLARE_API_TOKEN = ""
CLOUDFLARE_STT_MODEL = "@cf/openai/whisper-large-v3-turbo"
CLOUDFLARE_TEXT_MODEL = "@cf/zai-org/glm-4.7-flash"
