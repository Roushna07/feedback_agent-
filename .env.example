
# --- Optional Cloudflare Workers AI (text analysis only) ---------------------
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token

CLOUDFLARE_TEXT_MODEL=@cf/zai-org/glm-4.7-flash

# --- Local speech transcription (audio stays on this computer) ---------------
LOCAL_STT_MODEL=base

# --- Local SQLite (default backend; unchanged behaviour) ---------------------
DATABASE_PATH=data/healthcare_feedback.db
ADMIN_PASSWORD=admin123

# --- Supabase PostgreSQL backend (optional; local SQLite is the default) ------
# DB_BACKEND=postgres              # set explicitly to use Supabase PostgreSQL
# SUPABASE_URL=https://YOUR-REF.supabase.co        # Auth + API URL
# SUPABASE_ANON_KEY=your-public-anon-key           # public key (RLS protects data)
# SUPABASE_DB_URL=postgresql://postgres:...@aws-0-....pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_SSLMODE=require                      # optional; appended if missing
# SUPABASE_DB_ADMIN_MODE=0                         # ONLY the migration script sets 1
# AUTH_REQUIRED=0                                  # forced on automatically in postgres mode

# --- Translation service (modular; default = existing local NLLB model) ------
# TRANSLATION_BACKEND=local         # local | http | off   (do not change without approval)
# TRANSLATION_HTTP_URL=             # own free CPU service endpoint when backend=http
